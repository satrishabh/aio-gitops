{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "scaledDown": { "type": "boolean" },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage", "istio", "behavior"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "istio": {
          "type": "object",
          "required": ["enabled", "metricName", "requestsPerSecondPerReplica"],
          "properties": {
            "enabled": { "type": "boolean" },
            "metricName": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
            "requestsPerSecondPerReplica": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
          },
          "additionalProperties": false
        },
        "behavior": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
