{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "scaledDown": { "type": "boolean" },
    "spot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["aks", "gke"] }
      },
      "additionalProperties": false
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage", "istio", "behavior"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "istio": {
          "type": "object",
          "required": ["enabled", "metricName", "requestsPerSecondPerReplica"],
          "properties": {
            "enabled": { "type": "boolean" },
            "metricName": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
            "requestsPerSecondPerReplica": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
          },
          "additionalProperties": false
        },
        "behavior": { "type": "object" }
      },
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "required": ["enabled", "average", "burst", "maxConcurrent"],
      "properties": {
        "enabled": { "type": "boolean" },
        "average": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "burst": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxConcurrent": { "type": "integer", "minimum": 0, "maximum": 100000 }
      },
      "additionalProperties": false
    }
  }
}
