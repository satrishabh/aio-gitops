{
  "version": "2.0",
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" },
  "functionTimeout": "00:02:00",
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxPollingInterval": "00:00:10",
      "visibilityTimeout": "00:00:30",
      "maxDequeueCount": 40
    }
  },
  "logging": { "logLevel": { "default": "Information", "Host.Results": "Warning", "Function": "Information" } }
}
