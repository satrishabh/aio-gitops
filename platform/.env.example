OIDC_ISSUER_URI=https://profile.sarvaikam.com/realms/aio
OIDC_CLIENT_ID=aio-platform
OIDC_CLIENT_SECRET=
# PAT / GitHub App token: repo read on app repos, contents:write on GitOps repo, admin:repo_hook for webhooks
GITHUB_TOKEN=
ARGOCD_URL=https://localhost:8443
ARGOCD_TOKEN=
ARGOCD_INSECURE=true
APP_REGISTRY=ghcr.io/your-org
APP_PUBLIC_URL=
APP_BASE_DOMAIN=
GITOPS_REPO_URL=https://github.com/your-org/gitops.git
GITOPS_OWNER=your-org
GITOPS_REPO=gitops
GITOPS_BRANCH=main
ALLOWED_USERS=
# AIO client roles. Users without one remain registered in User Profile Manager but cannot enter AIO.
ALLOWED_ROLES=aio-admin,aio-business,aio-community
# Deprecated for login: OIDC does not expose GitHub organization membership.
ALLOWED_ORGS=
APPROVERS=
